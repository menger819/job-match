# ---- AI engine ----
# Option A (no key needed): leave the line below as it is. job-match then uses your
#   Claude Code login (it finds the Claude Code program automatically).
# Option B: paste an Anthropic API key from https://console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=sk-ant-put-your-key-here

# Which engine to use: auto (API key if set, otherwise Claude Code login) | api | claude-code
JOBMATCH_LLM=auto

# ---- Optional ----
# Default job location used when you don't pass --location (e.g. Taipei, Taichung, Kaohsiung, Remote)
JOBMATCH_LOCATION=Taipei

# Set to false if LinkedIn keeps blocking requests (HTTP 429 / 999)
LINKEDIN_ENABLED=true

# Claude model. With an API key the default is claude-opus-5-5;
# with Claude Code login, leave empty to use Claude Code's default model (or use opus / sonnet)
JOBMATCH_MODEL=

# Local embedding model used for retrieval (multilingual, ~2 GB download on first run)
JOBMATCH_EMBED_MODEL=BAAI/bge-m3
